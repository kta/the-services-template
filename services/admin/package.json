{
  "name": "@app/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/worker/index.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p src/web",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply admin --local",
    "db:migrate:remote": "wrangler d1 migrations apply admin --remote",
    "db:seed:local": "node seed.mjs",
    "db:seed:remote": "node seed.mjs --remote",
    "test": "vitest run --coverage",
    "test:web": "vitest run --config vitest.web.config.ts --coverage",
    "test:all": "pnpm run test && pnpm run test:web",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/ui": "workspace:*",
    "@hono/zod-validator": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/example_service": "workspace:*",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
