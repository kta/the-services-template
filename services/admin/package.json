{
  "name": "@app/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/worker/index.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node ../../scripts/run-without-cloudflare-env.mjs pnpm exec vite build && node ../../scripts/clean-build-secrets.mjs dist && node ../../scripts/check-tauri-artifact.mjs dist/client",
    "build:tauri": "node ../../scripts/native-workflow.mjs package build",
    "prepare:tauri:android": "node ../../scripts/prepare-tauri-android.mjs",
    "preview": "vite preview",
    "tauri": "node ../../scripts/native-workflow.mjs package tauri",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p src/web",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply admin --local",
    "db:seed:local": "node seed.mjs",
    "test": "vitest run --coverage",
    "test:web": "vitest run --config vitest.web.config.ts --coverage",
    "test:all": "pnpm run test && pnpm run test:web",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/ui": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "@hono/zod-validator": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/example_service": "workspace:*",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
