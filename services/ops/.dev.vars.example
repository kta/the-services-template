# ローカル開発用の dev 値。`make init` が .dev.vars にコピーする(.dev.vars は gitignore)。
# 本番は protected production workflow の allowlist 経由で設定(docs/howto/deploy.md)。
APP_ENV=development
OPS_TO_NOTIFIER_KEY=dev-ops-to-notifier-key-000000000000
# D1 REST export 用トークン(D1:Read のみにスコープ)。dev はダミーで良い
# (ローカルでは REST export を実行しない/テストは fetch をモック)。
D1_EXPORT_API_TOKEN=dev-d1-export-token
# Read-only Cloudflare R2 domain-policy check token (dev tests do not call the API).
R2_POLICY_CHECK_API_TOKEN=dev-r2-policy-check-token
OPS_ALERT_EMAIL=ops@example.com
# Optional for development. Production requires the private half through
# the protected production workflow and the public half in wrangler.jsonc vars.
# BACKUP_SIGNING_PRIVATE_KEY=<local-pkcs8-private-key>
