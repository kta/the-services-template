# Dependencies
node_modules/

# Build output
dist/
production-worker-manifest.json
production-worker-bundles.tar.gz
production-bootstrap-worker-bundles.tar.gz

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Vite env files (keep the *.example committed)
.env
.env.*
!.env.*.example

# Terraform inputs/state may contain account identifiers or credentials.
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*

# Generated worker binding types
worker-configuration.d.ts

# Test / coverage
coverage/
playwright-report/
test-results/

# Logs / OS / editor
*.log
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# design-select skill sessions (HTML mockups + server state)
.superpowers/

# Coding agents (personal/local state — keep shared skills & settings.json committed)
.claude/settings.local.json
.claude/worktrees/

# Tauri generates schemas and native build output below each app shell.
services/*/src-tauri/gen/
services/*/src-tauri/target/
services/*/src-tauri/permissions/autogenerated/
.claude/scheduled_tasks.lock
CLAUDE.local.md
