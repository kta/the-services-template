{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "schedule": ["after 10pm every weekday", "before 5am every weekday", "every weekend"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major devDependencies on green CI",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "dev dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "0.x releases may break on minor or patch updates",
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "Production deps: human review only",
      "matchDepTypes": ["dependencies", "peerDependencies"],
      "automerge": false
    },
    {
      "description": "Keep packageManager and mise pnpm pins in one review",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm toolchain",
      "automerge": false
    },
    {
      "description": "Never auto-merge majors",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "pnpm catalog loses dev/prod intent → group, human review",
      "matchDepTypes": ["pnpm.catalog.default"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pnpm catalog (non-major)",
      "automerge": false
    }
  ]
}
